# ── AWS / Bedrock ──────────────────────────────────────────────
AWS_REGION=us-east-2
# Modelo de generación (Bedrock) — configurable
BEDROCK_CHAT_MODEL_ID=anthropic.claude-haiku-4-5-20251001-v1:0
# Modelo de embeddings (fija 1024 dimensiones; cambiarlo obliga a reindexar)
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDINGS_DIMENSIONS=1024

# ── Storage (local + S3) ───────────────────────────────────────
# local | s3
STORAGE_DRIVER=local
S3_BUCKET=manual-taller-moto-rag-610433739351
LOCAL_DATA_DIR=./data

# ── Vector store ───────────────────────────────────────────────
# chroma | supabase (supabase: fase futura)
VECTORSTORE_DRIVER=chroma
CHROMA_PERSIST_DIR=./.chroma

# ── Chunking ───────────────────────────────────────────────────
CHUNK_SIZE=1200
CHUNK_OVERLAP=150

# ── Retrieval (MMR) ────────────────────────────────────────────
RETRIEVAL_K=6
MMR_FETCH_K=20
MMR_LAMBDA_MULT=0.5

# ── Memoria de conversación ────────────────────────────────────
MEMORY_MAX_TURNS=6

# ── Interfaz Telegram (secreto: no compartir) ──────────────────
TELEGRAM_BOT_TOKEN=

# ── General ────────────────────────────────────────────────────
LOG_LEVEL=INFO
